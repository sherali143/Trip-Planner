# ========================
# Environment & Secrets
# ========================
.env
.env.local

# ========================
# Python
# ========================
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
/dist/
# Anchored to the repository root. Unanchored, "build/" also matched
# report/build/, which is the report generator's source — so the entire
# generator was silently untracked and a fresh clone would not have built the
# dissertation at all.
/build/
*.egg

# ========================
# Virtual Environments
# ========================
venv/
.venv/
env/

# ========================
# IDE & Editors
# ========================
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# The deliverables live in submission/ and nowhere else. A copy of the deck sat
# at the root because PowerShell held the file open during the move, and a later
# `git add -A` committed it back — so the repository briefly shipped two of them
# and a reader had no way to know which was current. Anchored to the root, so
# submission/ is unaffected.
/CMP7200_Viva_Presentation.pptx
/CMP7200_Dissertation.docx
/PROJECT_OVERVIEW.docx

# Word's owner/lock files. It creates ~$name.docx beside any open document, and
# one got committed by a `git add -A` while PROJECT_OVERVIEW.docx was open. It is
# a lock file for a session that ended; it means nothing to anyone else.
~$*

# ========================
# Testing & Coverage
# ========================
.pytest_cache/
.coverage
htmlcov/
.tox/

# ========================
# Package Managers
# ========================
# Keep poetry.lock for reproducibility

# ========================
# OS Files
# ========================
*.log
*.tmp
# Debug dumps from ad-hoc API probing. The probe scripts that wrote these were
# deleted, but the patterns stay: the next person to debug a provider by dumping
# a payload should not commit it, because a raw response can carry account
# identifiers. The recorded responses under .api_cache/ are named by hash and are
# committed deliberately — none of them matches these patterns.
booking_flights_response.json
*_response.json
