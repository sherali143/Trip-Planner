# Copy to .env and fill in. Never commit .env — it is gitignored.

# --- LLM (Google Gemini, via LiteLLM) -----------------------------------
# Free tier: https://aistudio.google.com/apikey
# Both names are read; set them to the same key.
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# LiteLLM model string. Must keep the "gemini/" prefix.
#
# The published results were measured on gemini-2.5-flash, which Google has
# since withdrawn from new API keys. gemini-3.6-flash is the current free-tier
# model and runs the shipped three-agent path, but it REJECTS conversations
# ending with a model turn — which is how CrewAI's reasoning loop prompts — so
# the six-agent arms cannot run live on it. The demos default to replaying the
# recorded runs, so they are unaffected. See Section 6.7 of the dissertation.
GEMINI_MODEL=gemini/gemini-3.6-flash

# --- Web search: attractions and restaurants ----------------------------
# Free tier: https://serper.dev
SERPER_API_KEY=your_serper_api_key_here

# --- Flights + hotels (one key, two RapidAPI subscriptions) -------------
# https://rapidapi.com — subscribe to BOTH:
#   - fly-scraper        (flights)  free tier: 30 requests/MONTH
#   - booking-com15      (hotels)   free tier: 50 requests/MONTH
RAPIDAPI_KEY=your_rapidapi_key_here


# ========================================================================
# Optional — quota safety. Strongly recommended.
# ========================================================================
# The flight/hotel free tiers are MONTHLY and tiny. One careless run can
# spend the whole allowance, and it cannot be bought back until it resets.

# Replay recorded API responses instead of calling live endpoints.
# The repo ships with .api_cache/ populated, so `replay` reproduces the
# evaluation with NO API keys at all.
#   record (default) = use cache, call live only on a miss, then store
#   replay           = cache only, never touches the network
#   live             = always call live and refresh the cache
# TRIP_PLANNER_API_MODE=replay

# Hard ceiling on live API calls per run. Raises QuotaGuardTripped instead
# of quietly spending the rest of the month.
# TRIP_PLANNER_MAX_LIVE_CALLS=10

# Enrich the top N hotels with review breakdowns and nearby attractions.
# Each hotel costs 2 EXTRA Booking.com calls and none of it reaches the
# itinerary, so this is 0 by default.
# HOTEL_ENRICHMENT_TOP_N=0

# Restore verbose third-party HTTP logging. WARNING: Gemini passes its API
# key as a URL query parameter, so this prints your key to the console.
# TRIP_PLANNER_VERBOSE=1
