# ========================
# REQUIRED API KEYS
# ========================

# OpenAI API (Powers all agents with GPT-4o)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# Serper API (Web search for attractions & restaurants)
# Get from: https://serper.dev/
SERPER_API_KEY=your-serper-api-key-here

# RapidAPI (Flights via Kiwi.com + Hotels via Booking.com)
# Get from: https://rapidapi.com/
# Subscribe to: Kiwi.com Cheap Flights + Booking.com APIs
RAPIDAPI_KEY=your-rapidapi-key-here

# ========================
# OPTIONAL CONFIGURATION
# ========================

# Override default model (default: gpt-4o)
# Set to "gpt-4o", "gpt-4", "deepseek-v4-flash-free", etc.
OPENAI_MODEL=gpt-4o

# Organization ID (if using OpenAI org)
# OPENAI_ORGANIZATION_ID=org-your-org-id
